---
import { Image } from 'astro:assets';
import hero from '../assets/images/hero.png';
import globe from '../assets/images/globe.svg';
---

<section class="hero">
  <div class="hero__background">
    <Image src={hero} alt="Gradient background" loading="eager" />
  </div>

  <Image class="globe" src={globe} alt="Globe icon" loading="eager" />

  <p>
    <strong>Designer, engineer, builder.</strong> I’m located in San Diego with my dog Luka. I
    have over 15 year of experience working with clients directly, moving quickly at early-stage
    startups, and being responsible for shipping full products on my own.
  </p>
</section>

<style>
  .hero {
    align-items: center;
    aspect-ratio: 3 / 2;
    display: flex;
    flex-direction: column;
    margin-inline: auto;
    max-inline-size: 720px;
    padding-block-end: 48px;
    position: relative;

    .hero__background {
      animation-name: scaleIn;
      animation-duration: 3s;
      animation-fill-mode: forwards;
      animation-iteration-count: 1;
      animation-timing-function: ease;
      grid-column: 1 / -1;
      grid-row: 1 / -1;
      inset: 0;
      opacity: 0;
      position: absolute;
      transform: scaleX(0.8) skew(40deg);
      z-index: 0;
    }

    .globe {
      animation-name: zapIn;
      animation-delay: 0.75s;
      animation-duration: 1.5s;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
      animation-iteration-count: 1;
      margin-block: auto 32px;
      justify-self: center;
      inline-size: 96px;
      transform: scaleY(0);
      z-index: 1;
    }

    p {
      animation-name: fadeUp;
      animation-delay: 1.25s;
      animation-duration: 1.5s;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
      animation-iteration-count: 1;
      color: var(--label-2);
      font-size: 22px;
      line-height: var(--lineheight-5);
      opacity: 0;
      transform: translateY(24px);
      text-align: center;
      text-wrap: pretty;
      z-index: 1;

      strong {
        font-weight: var(--font-weight-6);
      }
    }
  }

  @keyframes scaleIn {
    to {
      opacity: 1;
      transform: scaleX(1) skew(0deg);
    }
  }

  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes zapIn {
    to {
      transform: scaleY(1);
    }
  }
</style>
