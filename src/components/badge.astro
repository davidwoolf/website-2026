---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle: string;
  /** Rendered 154px wide; supply rasters at 2x. */
  image: ImageMetadata;
  /** Any CSS angle, e.g. `-6deg`. */
  rotation?: string;
}

const { title, subtitle, image, rotation } = Astro.props;
---

<div class="badge" style={rotation && `rotate: ${rotation}`}>
  <div class="inner">
    <div class="cutout"></div>

    <div class="tag">
      <div class="cutout"></div>
    </div>

    <h3>{title}</h3>
    <p>{subtitle}</p>

    <!-- decorative: the title already names it -->
    <!-- a 2x version only helps rasters; an SVG is sharp at any size -->
    <Image
      class="image"
      src={image}
      alt=""
      width={154}
      densities={image.format === 'svg' ? undefined : [1, 2]}
    />
  </div>
</div>

<style>
  .badge {
    /* reusable variables for child elements */
    --badge-border-color: #dfdbda;
    --badge-inset-shadow: 0 2px 0 0 rgba(0, 0, 0, 0.1) inset, 0 0 2px 0 rgba(0, 0, 0, 0.1) inset;

    @media (color-gamut: p3) {
      --badge-border-color: color(display-p3 0.8706 0.8588 0.8549);
      --badge-inset-shadow:
        0 2px 0 0 color(display-p3 0 0 0 / 0.1) inset, 0 0 2px 0 color(display-p3 0 0 0 / 0.1) inset;
    }

    border-radius: 10px;
    background: linear-gradient(335deg, #f8f4f3 8.59%, rgba(255, 255, 255, 0.3) 88.6%);

    /* shadow */
    box-shadow: var(--shadow-1);
    block-size: 320px;
    inline-size: 225px;
    padding: 4px;
  }

  .inner {
    background-color: #fdfcfc;
    /* dashed grid tile; the 5% is baked into the SVG's stroke-opacity */
    background-image: url('data:image/svg+xml;base64,');
    background-repeat: repeat;
    background-size: 41px 41px;
    block-size: 100%;
    border-radius: 6px;
    box-shadow: var(--shadow-1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    inline-size: 100%;
    position: relative;

    .text {
      /* centered in the space above the image */
      text-align: center;
    }

    h3 {
      color: var(--label-1);
      font-size: 23px;
      font-stretch: condensed;
      font-weight: var(--font-weight-5);
      line-height: var(--lineheight-2);
      letter-spacing: var(--letterspacing-2);
    }

    p {
      color: var(--label-3);
      font-size: 18px;
      font-stretch: condensed;
      font-weight: var(--font-weight-5);
      line-height: var(--lineheight-2);
      letter-spacing: var(--letterspacing-2);
      margin-block-end: 33px;
    }

    /* hangs half its height past the bottom edge, and that half is clipped away; clip-path
       rather than overflow on .inner, which would also clip the tag poking out the top */
    .image {
      clip-path: inset(0 0 32.4% 0);
      inset-block-end: -50px;
      inset-inline-start: 50%;
      position: absolute;
      translate: -50% 0;
    }

    & > .cutout {
      background-color: #fdfcfc;
      block-size: 12px;
      border-radius: var(--radius-round);
      border: 1px solid var(--badge-border-color);
      box-shadow: var(--badge-inset-shadow);
      inline-size: 48px;
      inset-block-start: 12px;
      inset-inline-start: 50%;
      position: absolute;
      transform: translateX(-50%);
    }

    .tag {
      border-radius: 6px;
      background: linear-gradient(335deg, #f8f4f3 8.59%, rgba(255, 255, 255, 0.3) 88.6%);
      background: linear-gradient(
        335deg,
        color(display-p3 0.9686 0.9569 0.9529 / 0) 8.59%,
        color(display-p3 1 1 1 / 0.3) 88.6%
      );
      box-shadow:
        0 0 0 1px rgba(0, 0, 0, 0.03),
        0 2px 3px -1px rgba(0, 0, 0, 0.08),
        0 3px 12px -4px rgba(0, 0, 0, 0.08),
        0 4px 16px -8px rgba(0, 0, 0, 0.08),
        0 0 0 1px rgba(0, 0, 0, 0.05);
      box-shadow:
        0 0 0 1px color(display-p3 0 0 0 / 0.03),
        0 2px 3px -1px color(display-p3 0 0 0 / 0.08),
        0 3px 12px -4px color(display-p3 0 0 0 / 0.08),
        0 4px 16px -8px color(display-p3 0 0 0 / 0.08),
        0 0 0 1px color(display-p3 0 0 0 / 0.05);
      backdrop-filter: blur(1.5px);
      inline-size: 32px;
      block-size: 58px;
      inset-block-start: -40px;
      inset-inline-start: 50%;
      position: absolute;
      transform: translateX(-50%);

      .cutout {
        background: hsl(0deg 0% 100%);
        border-radius: 18px;
        border: 1px solid var(--badge-border-color);
        box-shadow: var(--badge-inset-shadow);
        height: 18px;
        margin-block-start: 6px;
        margin-inline: auto;
        inline-size: 18px;
      }
    }
  }
</style>
